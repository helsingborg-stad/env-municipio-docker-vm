# Core
DEPLOYMENT_MODE=standalone
DOCKER_SWARM=0
NODE_ROLE=data
NODE_NAME=municipio-01
NODE_ADDRESS=10.20.0.11
SITE_ADDRESS=example.test
# Use :80 when an upstream HTTP load balancer terminates TLS.
CADDY_SITE_ADDRESS=example.test

# Immutable releases. Every service is pinned by digest; tags are rejected.
MUNICIPIO_IMAGE=ghcr.io/municipio-se/municipio-deployment-docker@sha256:9a7a2502fa3ef00542d6859951ebff2af4e1055d3fcb057ed87fb7326c52dae1
MARIADB_IMAGE=mariadb@sha256:70cc072b29b4a89ae07abb2d4da2c64678a7f2dfe092751bb51c87d67dc1338b
CADDY_IMAGE=caddy@sha256:0c994536bddb66445885237f1a5dcc1916bccea922661c76b4e9fc24061f9b52
APP_BIND_ADDRESS=127.0.0.1
APP_BIND_PORT=8080

# Host paths
INSTALL_ROOT=/opt/municipio
CONFIG_ROOT=/etc/municipio
DATA_ROOT=/srv/municipio/data
GLUSTER_BRICK=/srv/municipio/gluster-brick
BACKUP_ROOT=/var/backups/municipio
HEALTH_ROOT=/var/lib/municipio/health
# The database directory must stay on local disk, never under DATA_ROOT.
DB_DATA_ROOT=/var/lib/municipio/mysql
# Shared MariaDB socket directory. Not under /run: that is a tmpfs and would be empty
# after a reboot, before the containers restart.
DB_SOCKET_DIR=/var/lib/municipio/mysqld-socket
# Must match the mysql user inside MARIADB_IMAGE.
DB_SOCKET_UID=999
DB_SOCKET_GID=999

# WordPress / MariaDB
DB_NAME=municipio
DB_USER=municipio
DB_PASSWORD=replace-me
DB_ROOT_PASSWORD=replace-me
DB_HOST=localhost:/run/mysqld/mysqld.sock
DB_TABLE_PREFIX=mun_
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=replace-me
WP_ADMIN_EMAIL=admin@example.test
WP_SITE_TITLE=Municipio
WP_DEBUG=false
WP_REDIS_DISABLED=true

# Two-node cluster. PRIMARY must be listed first for manual mode.
PRIMARY_NODE_NAME=municipio-01
PRIMARY_NODE_ADDRESS=10.20.0.11
SECONDARY_NODE_NAME=municipio-02
SECONDARY_NODE_ADDRESS=10.20.0.12

# Only required by cluster-arbitrator.
ARBITRATOR_NODE_NAME=municipio-arbiter
ARBITRATOR_NODE_ADDRESS=

# Package installation may be disabled when an image/template provides them.
INSTALL_PACKAGES=true
